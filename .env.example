# ==============================================================================
# Friend-Bot 機密金鑰環境變數範本 (.env)
# 請複製此檔案為 .env 並填入您的 Discord Bot Token 與 Gemini API Key
# ==============================================================================

# Discord Bot Token (從 Discord Developer Portal 取得)
DISCORD_TOKEN=your_discord_bot_token_here

# Google Gemini API Key (從 Google AI Studio 取得)
GEMINI_API_KEY=your_gemini_api_key_here

# (選填) 回覆頻道 ID 列表，逗號分隔 (也可直接在 config.yaml 中的 reply_channel_ids 設定)
# REPLY_CHANNEL_IDS=123456789012345678,987654321098765432

# (選填) 監聽頻道 ID 列表，逗號分隔 (也可直接在 config.yaml 中的 listen_channel_ids 設定)
# LISTEN_CHANNEL_IDS=112233445566778899

# (選填) 代發音樂 bot 指令（如 m.play）的頻道 ID (也可直接在 config.yaml 中的 music.command_channel_id 設定)
# MUSIC_COMMAND_CHANNEL_ID=112233445566778899
